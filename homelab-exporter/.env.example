# Copy to .env (never commit it). Every source is optional; unset ones report "off".
# LISTEN defaults to 127.0.0.1:9477 for `go run`; compose.yaml overrides it for the private network.
LISTEN=127.0.0.1:9477

# Proxmox: API token for a user with the PVEAuditor role (read-only) — see README "Proxmox token"
PROXMOX_URL=https://pve.example.lan:8006
PROXMOX_TOKEN=siteaudit@pve!site=00000000-0000-0000-0000-000000000000
PROXMOX_INSECURE_TLS=1

# real node name = public alias; unaliased nodes are published as node-1, node-2, …
ALIASES=pve1=atlas,pve2=hermes
TIMEOUT=3s

# cloudflared (compose.yaml): token of the dashboard-managed tunnel `homelab-status`
TUNNEL_TOKEN=

# Uptime Kuma (compose service `uptime-kuma`; KUMA_URL is set in compose.yaml)
# Admin UI bind address on the lab host — 0.0.0.0 = LAN + tailnet (CT has no public exposure)
KUMA_LISTEN=127.0.0.1
# Slug of the *public* status page — only monitors on that page leave the lab
KUMA_SLUG=site

# Not wired up yet (Q17) — uncomment when it exists:
# Prometheus (node_exporter on each node) — adds temperatures
# PROM_URL=http://prometheus.example.lan:9090
# PROM_TEMP_QUERY=max by (nodename) (node_hwmon_temp_celsius * on (instance) group_left (nodename) node_uname_info)
