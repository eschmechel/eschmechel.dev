<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
  <div class="panel lightbox__panel">
    <h2 class="panel__label" id="lightbox-label">image</h2>
    <span class="lightbox__count" id="lightbox-count"></span>
    <button class="lightbox__close" type="button" data-close aria-label="Close">[x]</button>
    <figure>
      <img id="lightbox-img" alt="" decoding="async" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
    <div class="lightbox__nav" id="lightbox-nav">
      <button type="button" data-step="-1" aria-label="Previous image">← prev</button>
      <button type="button" data-step="1" aria-label="Next image">next →</button>
    </div>
    <span class="panel__foot keyhint">[←/→ cycle · esc close]</span>
  </div>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>

<style>
  .lightbox {
    width: min(64rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0.8rem 0 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(5 5 4 / 0.78);
    backdrop-filter: blur(3px);
  }
  .lightbox__panel {
    margin: 0;
    background: var(--bg);
    border-color: var(--border-strong);
  }
  .lightbox__count,
  .lightbox__close {
    position: absolute;
    top: 0;
    transform: translateY(-55%);
    padding: 0 0.4rem;
    background: var(--bg);
    font: inherit;
    font-size: var(--fs-sm);
    line-height: 1;
  }
  .lightbox__count {
    left: auto;
    right: 3.6rem;
    color: var(--fg-dim);
  }
  .lightbox__close {
    right: 0.75rem;
    border: 0;
    color: var(--accent);
    cursor: pointer;
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 11rem);
    object-fit: contain;
    border-radius: 4px;
    background: var(--bg-raised);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--fg);
  }
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
  }
  .lightbox__nav[hidden] {
    display: none;
  }
  .lightbox__nav button {
    border: 0;
    background: none;
    padding: 0.2rem 0;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--fg-strong);
    cursor: pointer;
  }
  .lightbox__nav button:hover,
  .lightbox__close:hover {
    color: var(--accent);
  }
</style>
