---
import Panel from '../Panel.astro';
import { fmtDay, getPosts, readingMinutes } from '../../lib/content';

const posts = await getPosts();
const [latest, ...rest] = posts;
---

{
  latest && (
    <Panel label="latest">
      <a class="rss" href="/rss.xml" aria-label="RSS feed">rss</a>
      <a class="title" href={`/blog/${latest.id}`}>
        {latest.data.title}
      </a>
      <p class="desc">{latest.data.description}</p>
      <p class="meta">
        {fmtDay(latest.data.pubDate)} · {readingMinutes(latest.body)} min
        {latest.data.tags.slice(0, 4).map((t) => (
          <span class="tag">#{t}</span>
        ))}
      </p>
    </Panel>
  )
}

<Panel label="posts">
  <ul class="posts">
    {
      rest.map((p) => (
        <li>
          <span class="date">{fmtDay(p.data.pubDate)}</span>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <span class="min">{readingMinutes(p.body)}m</span>
        </li>
      ))
    }
  </ul>
</Panel>

<style>
  .rss {
    position: absolute;
    top: 0;
    right: 0.75rem;
    transform: translateY(-55%);
    padding: 0 0.4rem;
    background: var(--bg);
    font-size: var(--fs-sm);
    line-height: 1;
    color: var(--accent);
  }
  .title {
    display: block;
    color: var(--fg-strong);
    font-weight: 600;
  }
  .title:hover {
    color: var(--accent);
  }
  .desc {
    margin: 0.4rem 0 0.5rem;
  }
  .meta,
  .date,
  .min {
    font-size: var(--fs-sm);
    color: var(--fg-dim);
  }
  .tag {
    margin-left: 0.6rem;
  }
  .posts li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: baseline;
  }
  .posts li + li {
    margin-top: 0.55rem;
  }
  @media (max-width: 720px) {
    .posts li {
      grid-template-columns: 1fr auto;
    }
    .date {
      grid-column: 1 / -1;
    }
  }
</style>
