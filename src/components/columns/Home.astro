---
import { getCollection, render } from 'astro:content';
import Panel from '../Panel.astro';

const now = await getCollection('now');
const opinions = await Promise.all(
  (await getCollection('opinions')).map(async (o) => ({ ...o, Body: (await render(o)).Content })),
);
---

<Panel label="out exploring">
  <pre class="scene" role="img" aria-label="ASCII drawing: a kid pulling a wagon with a stuffed tiger riding in it">{String.raw`       _                        /\=/\
      (_)                      (=o.o=)
     /|_|\___________________  /     \
      | |                    \|_______|
     _| |_                    (o)   (o)
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~`}</pre>
</Panel>

<Panel label="now">
  <ul class="now">
    {
      now.map(({ data: n }) => (
        <li>
          <span class="now__label">{n.label}</span>
          {n.text}
        </li>
      ))
    }
  </ul>
</Panel>

<Panel label="homelab">
  <p class="dim">Live status from the lab (Proxmox · Prometheus · Uptime Kuma) arrives in the homelab phase.</p>
</Panel>

<Panel label="contributions">
  <p class="dim">GitHub activity heatmap — later phase.</p>
</Panel>

{
  opinions.map(({ data: o, Body }) => (
    <Panel label={o.title}>
      <div class="prose">
        <Body />
      </div>
      {o.stub && <p class="dim">(example stub — the real take goes here)</p>}
    </Panel>
  ))
}

<style>
  .scene {
    margin: 0;
    font: 0.8rem/1 var(--font);
    font-variant-ligatures: none;
    color: var(--fg-strong);
    overflow-x: auto;
  }
  .now li {
    display: flex;
    gap: 1rem;
  }
  .now__label {
    width: 6rem;
    flex-shrink: 0;
    color: var(--fg-dim);
  }
  .prose :global(p) {
    margin: 0 0 0.6em;
  }
  .dim {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
  }
</style>
