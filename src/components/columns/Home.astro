---
import { getCollection, render } from 'astro:content';
import Panel from '../Panel.astro';
import { getContributions } from '../../lib/github';

const now = await getCollection('now');
const contrib = await getContributions();
const opinions = await Promise.all(
  (await getCollection('opinions')).map(async (o) => ({ ...o, Body: (await render(o)).Content })),
);
---

<Panel label="out exploring">
  <pre class="scene" role="img" aria-label="ASCII drawing: a kid pulling a wagon with a stuffed tiger riding in it">{String.raw`       _                        /\=/\
      (_)                      (=o.o=)
     /|_|\___________________  /     \
      | |                    \|_______|
     _| |_                    (o)   (o)
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~`}</pre>
</Panel>

<Panel label="now">
  <ul class="now">
    {
      now.map(({ data: n }) => (
        <li>
          <span class="now__label">{n.label}</span>
          {n.text}
        </li>
      ))
    }
  </ul>
</Panel>

<Panel label="homelab">
  <div class="lab" id="homelab" data-state="loading" aria-live="polite">
    <p class="lab__note">checking the lab…</p>
  </div>
  <noscript><p class="dim">Live lab status needs JavaScript.</p></noscript>
</Panel>

<script>
  import { initHomelab } from '../../scripts/homelab';
  initHomelab();
</script>

<Panel label="contributions">
  {
    contrib ? (
      <>
        <a class="gh" href="https://github.com/eschmechel" target="_blank" rel="noopener">github ↗</a>
        <div
          class="heatmap"
          id="heatmap"
          data-days={contrib.levels}
          data-start={contrib.start}
          role="img"
          aria-label={`${contrib.total.toLocaleString('en-CA')} GitHub contributions in the last year`}
        />
        <p class="dim">{contrib.total.toLocaleString('en-CA')} contributions in the last year</p>
      </>
    ) : (
      <p class="dim">
        Contribution graph unavailable at build time — see <a href="https://github.com/eschmechel">github.com/eschmechel</a>.
      </p>
    )
  }
</Panel>

<script>
  import { initHeatmap } from '../../scripts/heatmap';
  initHeatmap();
</script>

{
  opinions.map(({ data: o, Body }) => (
    <Panel label={o.title}>
      <div class="prose">
        <Body />
      </div>
      {o.stub && <p class="dim">(example stub — the real take goes here)</p>}
    </Panel>
  ))
}

<style>
  .scene {
    margin: 0;
    /* 41 cols × ~0.63em advance; the panel is 100vw − 61px on phones, so shrink to fit */
    font: min(0.8rem, (100vw - 64px) / 26) / 1 var(--font);
    font-variant-ligatures: none;
    color: var(--fg-strong);
    padding-block: 1px; /* line-height 1 glyphs overhang by ~1px */
    overflow: hidden;
  }
  /* rendered by src/scripts/homelab.ts, so these need :global */
  .lab :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .lab :global(th) {
    text-align: left;
    font-weight: 400;
    color: var(--fg-dim);
    padding-bottom: 0.3rem;
  }
  .lab :global(td) {
    padding: 0.15rem 0.8rem 0.15rem 0;
    color: var(--fg-strong);
    white-space: nowrap;
  }
  .lab :global(tr.is-down td) {
    color: var(--warn);
  }
  .lab :global(.lab__svcs) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 0.8rem;
    font-size: var(--fs-sm);
  }
  .lab :global(.is-up .lab__dot) {
    color: var(--accent);
  }
  .lab :global(.is-down) {
    color: var(--warn);
  }
  .lab :global(.lab__pct) {
    color: var(--fg-dim);
  }
  .lab :global(.lab__note) {
    margin: 0.7rem 0 0;
    font-size: var(--fs-sm);
    color: var(--fg-dim);
  }
  .lab :global(.lab__note:first-child) {
    margin-top: 0;
  }
  .lab[data-state='stale'] :global(.lab__note:last-child) {
    color: var(--warn);
  }
  .gh {
    position: absolute;
    top: 0;
    right: 0.75rem;
    transform: translateY(-55%);
    padding: 0 0.4rem;
    background: var(--bg);
    font-size: var(--fs-sm);
    line-height: 1;
    color: var(--accent);
  }
  .heatmap {
    overflow-x: auto;
    padding-bottom: 0.4rem;
  }
  /* cells are created by src/scripts/heatmap.ts */
  .heatmap :global(.heat) {
    display: grid;
    grid-template-rows: repeat(7, 9px);
    grid-auto-flow: column;
    grid-auto-columns: 9px;
    gap: 2px;
    width: max-content;
  }
  .heatmap :global(.heat i) {
    border-radius: 2px;
    background: var(--border);
  }
  .heatmap :global(.heat .l1) {
    background: rgb(242 169 59 / 0.3);
  }
  .heatmap :global(.heat .l2) {
    background: rgb(242 169 59 / 0.52);
  }
  .heatmap :global(.heat .l3) {
    background: rgb(242 169 59 / 0.76);
  }
  .heatmap :global(.heat .l4) {
    background: var(--accent);
  }
  .now li {
    display: flex;
    gap: 1rem;
  }
  .now__label {
    width: 6rem;
    flex-shrink: 0;
    color: var(--fg-dim);
  }
  .prose :global(p) {
    margin: 0 0 0.6em;
  }
  .dim {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
  }
</style>
