---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Panel from '../Panel.astro';
import { getProjects } from '../../lib/content';

const featured = await Promise.all(
  (await getProjects('featured')).map(async (p) => ({
    ...p,
    Body: (await render(p)).Content,
    // full-size (capped) versions for the lightbox; thumbnails are generated by <Image>
    full: await Promise.all(p.data.images.map((img) => getImage({ src: img.src, width: Math.min(1600, img.src.width), format: 'webp' }))),
  })),
);
const archived = await Promise.all(
  (await getProjects('archived')).map(async (p) => ({ ...p, Body: (await render(p)).Content })),
);
const external = (href: string) => href.startsWith('http');
---

{
  featured.map(({ data: p, Body, full }) => (
    <Panel label={p.name}>
      <span class="when">{p.when}</span>
      <div class="summary">
        <Body />
      </div>
      {p.highlights.length > 0 && (
        <ul class="bullets">
          {p.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
      <div class="chips">
        {p.status.map((s) => (
          <span class={`chip chip--${s.tone}`}>{s.text}</span>
        ))}
        {p.tech.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
      {p.images.length > 0 && (
        <div class="thumbs">
          {p.images.map((img, i) => (
            <a
              href={full[i].src}
              class="thumb"
              data-lightbox={p.name}
              data-group={p.name}
              data-full={full[i].src}
              data-w={full[i].attributes.width}
              data-h={full[i].attributes.height}
              data-alt={img.alt}
              aria-label={`View image: ${img.alt}`}
            >
              <Image src={img.src} alt={img.alt} width={256} height={160} fit="cover" position="top" />
            </a>
          ))}
        </div>
      )}
      {p.links.length > 0 && (
        <ul class="links">
          {p.links.map((l) => (
            <li>
              <a href={l.href} target={external(l.href) ? '_blank' : undefined} rel="noopener">
                ↗ {l.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </Panel>
  ))
}

<Panel label="archive">
  <ul class="archive">
    {
      archived.map(({ data: p, Body }) => (
        <li>
          <a href={p.links[0]?.href} target="_blank" rel="noopener">{p.name}</a>
          <span class="archive__when">{p.when}</span>
          <div class="archive__note"><Body /></div>
        </li>
      ))
    }
  </ul>
</Panel>

<style>
  .when {
    position: absolute;
    top: 0;
    right: 0.75rem;
    transform: translateY(-55%);
    padding: 0 0.4rem;
    background: var(--bg);
    font-size: var(--fs-sm);
    line-height: 1;
    color: var(--fg-dim);
  }
  .summary :global(p) {
    margin: 0;
  }
  .bullets {
    margin-top: 0.6rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.2rem;
    font-size: var(--fs-sm);
  }
  .bullets li + li {
    margin-top: 0.2rem;
  }
  .bullets li::before {
    content: '›';
    position: absolute;
    left: 0.2rem;
    color: var(--accent);
  }
  .thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }
  .thumb {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    line-height: 0;
    transition: border-color 160ms;
  }
  .thumb:hover {
    border-color: var(--accent);
  }
  .thumb img {
    width: 128px;
    height: 80px;
    object-fit: cover;
    object-position: top;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.8rem;
    font-size: var(--fs-sm);
  }
  .archive li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    font-size: var(--fs-sm);
  }
  .archive li + li {
    margin-top: 0.6rem;
  }
  .archive__when {
    color: var(--fg-dim);
    text-align: right;
  }
  .archive__note {
    grid-column: 1 / -1;
    color: var(--fg-dim);
  }
  .archive__note :global(p) {
    margin: 0;
  }
</style>
