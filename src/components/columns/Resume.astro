---
import { getCollection } from 'astro:content';
import Panel from '../Panel.astro';
import { fmtMonth, fmtRange, getExperience, getProfile } from '../../lib/content';

const profile = (await getProfile()).data;
const jobs = await getExperience();
const schools = await getCollection('education');
const skills = await getCollection('skills');
---

<Panel label="resume">
  <a class="download" href={profile.resumePdf} download aria-label="Download resume (PDF)" title="Download PDF">↓ pdf</a>
  <p>{profile.headline}</p>
  <p class="dim">Everything below is also in the PDF.</p>
</Panel>

<Panel label="education">
  {
    schools.map(({ data: s }) => (
      <>
        <div class="row">
          <strong>{s.school}</strong>
          <span>{s.where}</span>
        </div>
        <div class="row sub">
          <span>{s.program}</span>
          <span>
            {fmtMonth(s.start)} – {fmtMonth(s.expected)} (expected)
          </span>
        </div>
      </>
    ))
  }
</Panel>

<Panel label="experience">
  {
    jobs.map(({ data: e }) => (
      <article class="job">
        <div class="row">
          <strong>{e.role}</strong>
          <span>{fmtRange(e.start, e.end)}</span>
        </div>
        <div class="row sub">
          <span>{e.org}</span>
          <span>{e.where}</span>
        </div>
        <ul class="bullets">
          {e.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </article>
    ))
  }
</Panel>

<Panel label="skills">
  {
    skills.map(({ data: s }) => (
      <div class="skill">
        <span class="skill__group">{s.group}</span>
        <div class="chips">
          {s.items.map((i) => (
            <span class="chip">{i}</span>
          ))}
        </div>
      </div>
    ))
  }
</Panel>

<style>
  .download {
    position: absolute;
    top: 0;
    right: 0.75rem;
    transform: translateY(-55%);
    padding: 0 0.4rem;
    background: var(--bg);
    font-size: var(--fs-sm);
    line-height: 1;
    color: var(--accent);
  }
  .download:hover {
    color: var(--fg-strong);
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  strong {
    color: var(--fg-strong);
    font-weight: 600;
  }
  .sub {
    font-size: var(--fs-sm);
  }
  .job + .job {
    margin-top: 1.1rem;
  }
  .bullets {
    margin-top: 0.4rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.2rem;
    font-size: var(--fs-sm);
  }
  .bullets li::before {
    content: '›';
    position: absolute;
    left: 0.2rem;
    color: var(--accent);
  }
  .skill + .skill {
    margin-top: 0.9rem;
  }
  .skill__group {
    font-size: var(--fs-sm);
    color: var(--fg-dim);
  }
  .skill .chips {
    margin-top: 0.35rem;
  }
  .dim {
    color: var(--fg-dim);
  }
</style>
