---
import Panel from '../Panel.astro';
import { BANNER, PROFILE } from '../../data/seed';
---

<Panel label="me">
  <div class="me">
    <pre class="banner" aria-label={PROFILE.name}>{BANNER}</pre>
    <ul class="facts">
      {
        PROFILE.facts.map((f) => (
          <li>
            <span class="facts__icon" aria-hidden="true">{f.icon}</span>
            {f.text}
          </li>
        ))
      }
    </ul>
  </div>
</Panel>

<Panel label="socials">
  <ul class="socials">
    {PROFILE.socials.map((s) => <li><a href={s.href} rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a></li>)}
  </ul>
</Panel>

<Panel label="about">
  <p class="headline">{PROFILE.headline}</p>
  <p>
    I ship end to end across Go, C++, TypeScript and Python — most recently an on-device lip-reading
    pipeline, a loop that turns an agent's repeated work into small fine-tuned specialists, and
    serverless backends on Cloudflare's edge.
  </p>
  <p>Final-year CS at Langara. Previously a Technical Content Engineer at LicenseSpring.</p>
</Panel>

<Panel label="ask">
  <p class="dim">The command bar and agent land in a later phase. Press <kbd>2</kbd> for projects meanwhile.</p>
</Panel>

<style>
  .me {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  .banner {
    margin: 0;
    color: var(--accent);
    font-size: 0.78rem;
    line-height: 1.2;
    flex-shrink: 0;
  }
  .facts li {
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--fg-strong);
  }
  .facts__icon {
    width: 1.6em;
    color: var(--fg-dim);
    text-align: center;
  }
  .socials {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .headline {
    color: var(--fg-strong);
  }
  .dim {
    color: var(--fg-dim);
  }
  kbd {
    font: inherit;
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .me {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
