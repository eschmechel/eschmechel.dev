---
import { render } from 'astro:content';
import Panel from '../Panel.astro';
import { banner, getProfile } from '../../lib/content';

const profile = await getProfile();
const { Content } = await render(profile);
const p = profile.data;
const art = banner(p.handle);
---

<Panel label="me">
  <div class="me">
    <pre class="banner" role="img" aria-label={p.name}>{art}</pre>
    <ul class="facts">
      {
        p.facts.map((f) => (
          <li>
            <span class="facts__icon" aria-hidden="true">{f.icon}</span>
            {f.text}
          </li>
        ))
      }
    </ul>
  </div>
</Panel>

<Panel label="socials">
  <ul class="socials">
    {
      p.socials.map((s) => (
        <li>
          <a href={s.href} rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a>
        </li>
      ))
    }
  </ul>
</Panel>

<Panel label="about">
  <p class="headline">{p.headline}</p>
  <div class="prose"><Content /></div>
</Panel>

<Panel label="ask">
  <p class="dim">The command bar and agent land in a later phase. Press <kbd>2</kbd> for projects meanwhile.</p>
</Panel>

<style>
  .me {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  /* ASCII art only lines up when rows touch and glyphs keep their exact advance */
  .banner {
    flex-shrink: 0;
    margin: 0;
    color: var(--accent);
    font-family: var(--font);
    font-size: 0.8rem;
    line-height: 1;
    letter-spacing: 0;
    font-kerning: none;
    font-variant-ligatures: none;
    white-space: pre;
  }
  .facts li {
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--fg-strong);
  }
  .facts__icon {
    width: 1.6em;
    color: var(--fg-dim);
    text-align: center;
  }
  .socials {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .headline {
    color: var(--fg-strong);
  }
  .prose :global(p) {
    margin: 0 0 0.9em;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .dim {
    color: var(--fg-dim);
  }
  kbd {
    font: inherit;
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .me {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .banner {
      font-size: 0.72rem;
    }
  }
</style>
