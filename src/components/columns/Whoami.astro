---
import { render } from 'astro:content';
import Panel from '../Panel.astro';
import { banner, getProfile } from '../../lib/content';
import { SUGGESTED } from '../../agent/core';

const profile = await getProfile();
const { Content } = await render(profile);
const p = profile.data;
const art = banner(p.handle);
---

<Panel label="me">
  <div class="me">
    <pre class="banner" role="img" aria-label={p.name}>{art}</pre>
    <ul class="facts">
      {
        p.facts.map((f) => (
          <li>
            <span class="facts__icon" aria-hidden="true">{f.icon}</span>
            {f.text}
          </li>
        ))
      }
    </ul>
  </div>
</Panel>

<Panel label="socials">
  <ul class="socials">
    {
      p.socials.map((s) => (
        <li>
          <a href={s.href} rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a>
        </li>
      ))
    }
  </ul>
</Panel>

<Panel label="about">
  <p class="headline">{p.headline}</p>
  <div class="prose"><Content /></div>
</Panel>

<Panel label="ask">
  <div class="log" id="agent-log" aria-live="polite">
    <p class="log__hint dim">Press <kbd>/</kbd> and ask anything about Elliott, or <kbd>:help</kbd> for commands.</p>
  </div>
  <ul class="suggest" aria-label="Suggested questions">
    {
      SUGGESTED.map((q) => (
        <li>
          <button type="button" data-ask={q}>{q}</button>
        </li>
      ))
    }
  </ul>
</Panel>

<style>
  .me {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  /* ASCII art only lines up when rows touch and glyphs keep their exact advance */
  .banner {
    flex-shrink: 0;
    margin: 0;
    color: var(--accent);
    font-family: var(--font);
    font-size: 0.8rem;
    line-height: 1;
    letter-spacing: 0;
    font-kerning: none;
    font-variant-ligatures: none;
    white-space: pre;
  }
  .facts li {
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--fg-strong);
  }
  .facts__icon {
    width: 1.6em;
    color: var(--fg-dim);
    text-align: center;
  }
  .socials {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .headline {
    color: var(--fg-strong);
  }
  .prose :global(p) {
    margin: 0 0 0.9em;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .dim {
    color: var(--fg-dim);
  }
  kbd {
    font: inherit;
    color: var(--accent);
  }
  .log {
    max-height: 18rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .log :global(p) {
    margin: 0 0 0.55rem;
    white-space: pre-wrap;
    font-size: var(--fs-sm);
  }
  .log :global(.log__q) {
    color: var(--accent);
  }
  .log :global(.log__a) {
    color: var(--fg-strong);
  }
  .log :global(.log__err) {
    color: var(--warn);
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }
  .suggest button {
    border: 1px dashed var(--border-strong);
    border-radius: 5px;
    background: none;
    padding: 0.1rem 0.5rem;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--fg);
    cursor: pointer;
  }
  .suggest button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .me {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .banner {
      font-size: 0.72rem;
    }
  }
</style>
