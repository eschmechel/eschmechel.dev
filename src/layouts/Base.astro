---
// Latin subset only, two weights: keeps inlined CSS small enough for the 14 KB first flight.
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import plexRegular from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import { execSync } from 'node:child_process';
import { COLUMNS } from '../data/columns';
import { getProfile, reportUnverified } from '../lib/content';
import Panel from '../components/Panel.astro';

interface Props {
  title: string;
  description?: string;
  /** site-relative path used for <link rel=canonical> */
  path: string;
  /** index into COLUMNS for aria-current in the nav */
  active: number;
  keysLeft: string;
  keysRight: string;
  type?: 'website' | 'article';
}
const { title, description, path, active, keysLeft, keysRight, type = 'website' } = Astro.props;

function commitSha(): string | undefined {
  // Workers Builds injects WORKERS_CI_COMMIT_SHA (Pages used CF_PAGES_COMMIT_SHA)
  const sha = process.env.WORKERS_CI_COMMIT_SHA ?? process.env.CF_PAGES_COMMIT_SHA;
  if (sha) return sha;
  try {
    return execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {
    return undefined;
  }
}
const sha = commitSha();
const commit = sha?.slice(0, 7) ?? 'dev';
const commitUrl = sha && `https://github.com/eschmechel/eschmechel.dev/commit/${sha}`;
const profile = (await getProfile()).data;
await reportUnverified();
const canonical = new URL(path, Astro.site);
const desc = description ?? `${profile.name} — ${profile.headline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="preload" href={plexRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — blog`} href="/rss.xml" />
    <meta name="theme-color" content="#0d0c0b" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="chrome chrome--top">
      <Panel label="nav" as="nav">
        <ul class="nav">
          {
            COLUMNS.map((c, i) => (
              <li>
                <a href={c.href} data-nav={i} aria-current={i === active ? 'page' : undefined}>
                  <span class="kbd">[{c.key}] </span>
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </Panel>
    </header>

    <slot />

    <footer class="chrome chrome--bottom" id="footer">
      <slot name="companion" />
      <Panel label="footer" as="div">
        <div class="footer">
          <span>© 2026 · {profile.handle}</span>
          {commitUrl ? <a href={commitUrl} title="view this commit on GitHub">⎇ {commit}</a> : <span title="commit">⎇ {commit}</span>}
        </div>
        <span slot="foot" class="panel__foot keyhint">{keysLeft}</span>
        <span slot="foot" class="panel__foot panel__foot--right keyhint">{keysRight}</span>
      </Panel>
    </footer>
  </body>
</html>
