---
import { COLUMNS, type ColumnId } from '../data/columns';
import Base from './Base.astro';
import Whoami from '../components/columns/Whoami.astro';
import Projects from '../components/columns/Projects.astro';
import Resume from '../components/columns/Resume.astro';
import Blog from '../components/columns/Blog.astro';
import Home from '../components/columns/Home.astro';
import Lightbox from '../components/Lightbox.astro';
import CommandBar from '../components/CommandBar.astro';

interface Props {
  initial: ColumnId;
}
const { initial } = Astro.props;
const index = COLUMNS.findIndex((c) => c.id === initial);
const column = COLUMNS[index];
const body = { whoami: Whoami, projects: Projects, resume: Resume, blog: Blog, home: Home };
---

<Base title={column.title} path={column.href} active={index} keysLeft="[1-5 column · ←/→ h/l scroll]" keysRight="[↑/↓ j/k panel · / ask]">
  <CommandBar slot="companion" />
  <main class="viewport" id="viewport">
    <div class="track" id="track" style={`--i:${index}`} data-active={index}>
      {
        COLUMNS.map((c, i) => {
          const Body = body[c.id];
          return (
            <section
              class="column"
              id={`col-${c.id}`}
              data-col={i}
              data-id={c.id}
              data-href={c.href}
              data-title={c.title}
              data-active={String(i === index)}
              aria-label={c.label}
              inert={i !== index}
            >
              <Body />
            </section>
          );
        })
      }
    </div>
  </main>

  <Lightbox />

  <script>
    import { initCarousel } from '../scripts/carousel';
    initCarousel();
  </script>
</Base>
